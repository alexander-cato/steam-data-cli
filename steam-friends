# ── terminal helpers ────────────────────────────────────────────────────────

def _use_color(stream) -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("TERM") == "dumb":
        return False
    return hasattr(stream, "isatty") and stream.isatty()


COLOR = _use_color(sys.stderr)


def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if COLOR else text


def info(msg: str) -> None:
    print(_c("2", f"  {msg}"), file=sys.stderr)


def warn(msg: str) -> None:
    print(_c("33", f"  warning: {msg}"), file=sys.stderr)


def die(msg: str, hint: str = "", code: int = 1):
    print(_c("31;1", "error: ") + msg, file=sys.stderr)
    if hint:
        print("\n" + hint, file=sys.stderr)
    sys.exit(code)


def display_width(s: str) -> int:
    """Terminal cell width of a string, accounting for wide and combining chars."""
    w = 0
    for ch in s:
        if unicodedata.combining(ch):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def pad(s: str, width: int) -> str:
    return s + " " * max(0, width - display_width(s))


# ── HTTP ────────────────────────────────────────────────────────────────────

class SteamError(Exception):
    def __init__(self, message: str, status: int = 0, hint: str = ""):
        super().__init__(message)
        self.status = status
        self.hint = hint


class SnapshotError(Exception):
    pass


def _redact(text: str, secret: str) -> str:
    """Never let a key reach a log line, traceback, or terminal."""
    return text.replace(secret, "<redacted>") if secret else text


def call(endpoint: str, key: str, params: dict) -> dict:
    """GET a Steam Web API endpoint with retries; return the parsed JSON body.

    The key travels in the query string (Steam offers no header auth), but it is
    never placed in argv and is scrubbed from every error path.
    """
    query = dict(params)
    query["key"] = key
    url = f"{API}/{endpoint}?" + urllib.parse.urlencode(query)
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})

    last = ""
    for attempt in range(1, RETRIES + 1):
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                raw = r.read().decode("utf-8", "replace")
            if not raw.strip():
                raise SteamError(f"{endpoint} returned an empty body")
            try:
                data = json.loads(raw)
            except json.JSONDecodeError as e:
                raise SteamError(f"{endpoint} returned malformed JSON ({e})")
            if not isinstance(data, dict):
                raise SteamError(f"{endpoint} returned JSON that is not an object")
            return data

        except urllib.error.HTTPError as e:
            body = ""
            try:
                raw_body = e.read().decode("utf-8", "replace")
                body = re.sub(r"<[^>]+>", " ", raw_body)
                body = re.sub(r"\s+", " ", body).strip()[:160]
            except Exception:
                pass

            if e.code in (401, 403):
                hint = ""
                if "GetFriendList" not in endpoint:
                    hint = (
                        "Steam rejected the API key itself. Check that it was copied\n"
                        "whole from https://steamcommunity.com/dev/apikey, and that it\n"
                        "has not been revoked or regenerated since."
                    )
                raise SteamError(
                    f"Steam returned HTTP {e.code} for {endpoint.split('/')[1]}"
                    + (f": {body}" if body and body not in ("{}", "") else ""),
                    status=e.code, hint=hint,
                )
            if e.code == 429:
                last = "HTTP 429 rate limited"
            elif 500 <= e.code < 600:
                last = f"HTTP {e.code} server error"
            else:
                raise SteamError(
                    f"HTTP {e.code} from {endpoint}"
                    + (f": {body}" if body else ""),
                    status=e.code,
                )

        except urllib.error.URLError as e:
            last = f"network error: {_redact(str(e.reason), key)}"
        except TimeoutError:
            last = f"timed out after {TIMEOUT}s"
        except SteamError as e:
            last = str(e)

        if attempt < RETRIES:
            backoff = min(2 ** attempt, 8)
            info(f"{last}; retrying in {backoff}s ({attempt}/{RETRIES - 1})")
            time.sleep(backoff)

    raise SteamError(f"{endpoint} failed after {RETRIES} attempts. {last}")


# ── config ──────────────────────────────────────────────────────────────────

def load_config() -> dict:
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            warn(f"{CONFIG_PATH} is not a JSON object; ignoring it")
            return {}
        mode = stat.S_IMODE(os.stat(CONFIG_PATH).st_mode)
        if mode & 0o077:
            warn(f"{CONFIG_PATH} is readable by others (mode {mode:04o}); "
                 f"run: chmod 600 {CONFIG_PATH}")
        config = {}
        for field in ("api_key", "steam_id"):
            value = data.get(field)
            if value is None:
                continue
            if not isinstance(value, str):
                warn(f"{CONFIG_PATH}: {field} must be a string; ignoring it")
                continue
            config[field] = value
        return config
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as e:
        warn(f"could not read {CONFIG_PATH}: {e}")
        return {}


def save_config(key: str, steam_id: str) -> None:
    try:
        os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
        fd = os.open(CONFIG_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump({"api_key": key, "steam_id": steam_id}, f, indent=2)
            f.write("\n")
        os.chmod(CONFIG_PATH, 0o600)
        info(f"saved to {CONFIG_PATH} (mode 0600)")
    except OSError as e:
        warn(f"could not save config: {e}")


# ── snapshots ───────────────────────────────────────────────────────────────

def default_snapshot_path(steam_id: str, relationship: str) -> str:
    return os.path.join(SNAPSHOT_DIR, f"{steam_id}-{relationship}.json")


def load_snapshot(path: str, steam_id: str, relationship: str):
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, UnicodeError, json.JSONDecodeError) as e:
        raise SnapshotError(f"could not read snapshot {path}: {e}")

    if not isinstance(data, dict) or data.get("version") != 1:
        raise SnapshotError(f"{path} is not a supported steam-friends snapshot")
    if data.get("steam_id") != steam_id:
        raise SnapshotError(
            f"{path} belongs to SteamID64 {data.get('steam_id')!r}, not {steam_id}"
        )
    if data.get("relationship") != relationship:
        raise SnapshotError(
            f"{path} tracks relationship={data.get('relationship')!r}, "
            f"not {relationship!r}"
        )
    if not isinstance(data.get("captured_at"), int):
        raise SnapshotError(f"{path} has an invalid captured_at timestamp")
    friends = data.get("friends")
    if not isinstance(friends, list):
        raise SnapshotError(f"{path} has no valid friends list")
    seen_ids = set()
    for friend in friends:
        if (not isinstance(friend, dict)
                or not isinstance(friend.get("steamid"), str)
                or not friend["steamid"]
                or friend["steamid"] in seen_ids
                or not isinstance(friend.get("friend_since"), int)
                or not isinstance(friend.get("name"), str)
                or not isinstance(friend.get("relationship"), str)):
            raise SnapshotError(f"{path} contains an invalid friend entry")
        seen_ids.add(friend["steamid"])
    return data


def prepare_snapshot_rows(rows: list, previous=None) -> list:
    previous_by_id = {
        row["steamid"]: row for row in (previous or {}).get("friends", [])
    }
    snapshot_rows = []
    for row in rows:
        if not row["steamid"]:
            continue
        old = previous_by_id.get(row["steamid"], {})
        snapshot_rows.append({
            "steamid": row["steamid"],
            "friend_since": row["friend_since"],
            "name": row["name"] or old.get("name", ""),
            "relationship": row["relationship"],
        })
    return sorted(snapshot_rows, key=lambda row: row["steamid"])


def compare_snapshot_rows(previous: list, current: list) -> dict:
    old_by_id = {row["steamid"]: row for row in previous}
    new_by_id = {row["steamid"]: row for row in current}
    added = [new_by_id[sid] for sid in sorted(new_by_id.keys() - old_by_id.keys())]
    removed = [old_by_id[sid] for sid in sorted(old_by_id.keys() - new_by_id.keys())]
    renamed = []
    for sid in sorted(old_by_id.keys() & new_by_id.keys()):
        old_name = old_by_id[sid]["name"]
        new_name = new_by_id[sid]["name"]
        if old_name and new_name and old_name != new_name:
            renamed.append((old_by_id[sid], new_by_id[sid]))
    return {"added": added, "removed": removed, "renamed": renamed}


def _snapshot_identity(row: dict) -> str:
    return f"{row['name']} ({row['steamid']})" if row["name"] else row["steamid"]


def render_snapshot_changes(changes: dict, captured_at: int) -> str:
    when = time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(captured_at))
    counts = (
        f"{len(changes['added'])} added, {len(changes['removed'])} removed, "
        f"{len(changes['renamed'])} renamed"
    )
    lines = [f"friend changes since {when}: {counts}"]
    lines += [f"  + {_snapshot_identity(row)}" for row in changes["added"]]
    lines += [f"  - {_snapshot_identity(row)}" for row in changes["removed"]]
    lines += [
        f"  ~ {old['name']} → {new['name']} ({old['steamid']})"
        for old, new in changes["renamed"]
    ]
    return "\n".join(lines)


def save_snapshot(
    path: str, steam_id: str, relationship: str, friends: list,
    captured_at: int = None,
) -> None:
    data = {
        "version": 1,
        "steam_id": steam_id,
        "relationship": relationship,
        "captured_at": int(time.time()) if captured_at is None else captured_at,
        "friends": friends,
    }
    directory = os.path.dirname(os.path.abspath(path))
    temporary_path = ""
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=directory,
            prefix=".steam-friends-", delete=False,
        ) as f:
            temporary_path = f.name
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, path)
    except OSError as e:
        if temporary_path:
            try:
                os.unlink(temporary_path)
            except OSError:
                pass
        raise SnapshotError(f"could not save snapshot {path}: {e}")


def update_snapshot(path: str, steam_id: str, relationship: str, rows: list) -> str:
    previous = load_snapshot(path, steam_id, relationship)
    current = prepare_snapshot_rows(rows, previous)
    changes = None if previous is None else compare_snapshot_rows(
        previous["friends"], current
    )
    save_snapshot(path, steam_id, relationship, current)
    if previous is None:
        noun = "friend" if len(current) == 1 else "friends"
        return f"snapshot baseline saved: {len(current)} {noun}\n  {path}"
    return render_snapshot_changes(changes, previous["captured_at"])


# ── identity resolution ─────────────────────────────────────────────────────

def parse_identity(raw: str):
    """Return ('id64'|'vanity', value) from an id, vanity name, or profile URL."""
    s = raw.strip()
    if not s:
        raise ValueError("empty identifier")

    if "://" in s or "/" in s:
        parsed = urllib.parse.urlparse(s if "://" in s else "https://" + s)
        if parsed.scheme not in ("http", "https") or parsed.hostname not in PROFILE_HOSTS:
            raise ValueError(f"{s!r} is not a Steam Community profile URL")
        path = parsed.path
        parts = [p for p in path.split("/") if p]
        for i, part in enumerate(parts):
            if part in ("profiles", "id") and i + 1 < len(parts):
                nxt = parts[i + 1]
                if part == "profiles":
                    if not ID64_RE.match(nxt):
                        raise ValueError(f"{nxt!r} in /profiles/ is not a SteamID64")
                    return "id64", nxt
                if not VANITY_RE.match(nxt):
                    raise ValueError(f"{nxt!r} in /id/ is not a valid vanity name")
                return "vanity", nxt
        raise ValueError(f"could not find a profile in URL {s!r}")

    if s.isdigit():
        if not ID64_RE.match(s):
            raise ValueError(
                f"{s!r} is numeric but not a SteamID64 "
                "(expected 17 digits beginning 7656119)"
            )
        return "id64", s

    if VANITY_RE.match(s):
        return "vanity", s

    raise ValueError(f"{s!r} is not a recognisable SteamID64, vanity name, or profile URL")


def resolve(raw: str, key: str) -> str:
    kind, value = parse_identity(raw)
    if kind == "id64":
        return value

    info(f"resolving vanity name {value!r}…")
    resp = call("ISteamUser/ResolveVanityURL/v1/", key, {"vanityurl": value}).get("response", {})
    if not isinstance(resp, dict):
        raise SteamError("ResolveVanityURL returned an unexpected response shape")
    if resp.get("success") != 1 or not resp.get("steamid"):
        raise SteamError(
            f"no Steam account has the vanity name {value!r} "
            f"({resp.get('message') or 'not found'})",
            hint="Check the spelling, or pass the 17-digit SteamID64 directly.",
        )
    return resp["steamid"]


# ── data fetching ───────────────────────────────────────────────────────────

def fetch_friends(steam_id: str, key: str, relationship: str) -> list:
    try:
        resp = call(
            "ISteamUser/GetFriendList/v1/", key,
            {"steamid": steam_id, "relationship": relationship},
        )
    except SteamError as e:
        if e.status in (401, 403):
            raise SteamError(
                f"Steam refused the friends list for {steam_id} (HTTP {e.status}).",
                status=e.status,
                hint=(
                    "The API key is fine. This is a privacy setting.\n\n"
                    "Steam treats the friends list as SEPARATE from overall profile\n"
                    "privacy, and GetFriendList enforces it. Owning the API key does\n"
                    "not grant privileged access to your own list.\n\n"
                    "Fix: Steam → Profile → Edit Profile → Privacy Settings, set\n"
                    '  "My friends list"  →  Public\n'
                    "then re-run. You can set it back afterwards; it only needs to be\n"
                    "public for the moment of the call."
                ),
            )
        raise

    friends_list = resp.get("friendslist")
    if not isinstance(friends_list, dict):
        raise SteamError("unexpected response shape: no friendslist object")
    friends = friends_list.get("friends")
    if friends is None:
        raise SteamError("unexpected response shape: no friendslist.friends key")
    if not isinstance(friends, list) or any(not isinstance(friend, dict) for friend in friends):
        raise SteamError("unexpected response shape: friendslist.friends is not a list of objects")
    return friends


def fetch_players(ids: list, key: str) -> dict:
    """Map SteamID64 to player summaries, batching at Steam's 100-id limit."""
    players_by_id = {}
    batches = [ids[i:i + SUMMARY_BATCH] for i in range(0, len(ids), SUMMARY_BATCH)]
    for n, batch in enumerate(batches, 1):
        if len(batches) > 1:
            info(f"fetching profiles, batch {n}/{len(batches)}…")
        try:
            resp = call("ISteamUser/GetPlayerSummaries/v2/", key,
                        {"steamids": ",".join(batch)})
            response = resp.get("response")
            players = response.get("players") if isinstance(response, dict) else None
            if not isinstance(players, list):
                raise SteamError("GetPlayerSummaries returned an unexpected response shape")
        except SteamError as e:
            warn(f"profile lookup batch {n} failed ({e}); those rows show the raw id")
            continue
        for p in players:
            if isinstance(p, dict) and p.get("steamid"):
                players_by_id[p["steamid"]] = p
    return players_by_id


def fetch_bans(ids: list, key: str) -> dict:
    """Map SteamID64 to public ban records, batching at 100 ids per call."""
    bans_by_id = {}
    batches = [ids[i:i + SUMMARY_BATCH] for i in range(0, len(ids), SUMMARY_BATCH)]
    for n, batch in enumerate(batches, 1):
        if len(batches) > 1:
            info(f"fetching ban records, batch {n}/{len(batches)}…")
        try:
            response = call(
                "ISteamUser/GetPlayerBans/v1/", key,
                {"steamids": ",".join(batch)},
            )
            players = response.get("players")
            if not isinstance(players, list):
                raise SteamError("GetPlayerBans returned an unexpected response shape")
        except SteamError as e:
            warn(f"ban lookup batch {n} failed ({e}); those rows show unknown")
            continue
        for player in players:
            if isinstance(player, dict) and player.get("SteamId"):
                bans_by_id[str(player["SteamId"])] = player
    return bans_by_id


# ── output ──────────────────────────────────────────────────────────────────

def fmt_time(ts: int, utc: bool) -> str:
    if not ts:
        return ""
    fn = time.gmtime if utc else time.localtime
    return time.strftime("%Y-%m-%d %H:%M", fn(ts))


def build_rows(
    friends: list, players: dict, utc: bool, oldest_first: bool, bans=None
) -> list:
    rows = []
    bans = bans or {}
    for f in friends:
        sid = str(f.get("steamid", ""))
        player = players.get(sid, {})
        ban = bans.get(sid)
        try:
            ts = max(0, int(f.get("friend_since") or 0))
        except (TypeError, ValueError):
            ts = 0
        try:
            state = PERSONA_STATES.get(int(player.get("personastate")), "unknown")
        except (TypeError, ValueError):
            state = "unknown"
        try:
            last_logoff = max(0, int(player.get("lastlogoff") or 0))
        except (TypeError, ValueError):
            last_logoff = 0
        try:
            account_created = max(0, int(player.get("timecreated") or 0))
        except (TypeError, ValueError):
            account_created = 0
        try:
            visibility = PROFILE_VISIBILITY.get(
                int(player.get("communityvisibilitystate")), "unknown"
            )
        except (TypeError, ValueError):
            visibility = "unknown"
        if ban is None:
            community_banned = None
            vac_banned = None
            vac_bans = None
            game_bans = None
            days_since_last_ban = None
            economy_ban = ""
            ban_status = "unknown"
        else:
            community_banned = ban.get("CommunityBanned") is True
            vac_banned = ban.get("VACBanned") is True
            try:
                vac_bans = max(0, int(ban.get("NumberOfVACBans") or 0))
            except (TypeError, ValueError):
                vac_bans = 0
            try:
                game_bans = max(0, int(ban.get("NumberOfGameBans") or 0))
            except (TypeError, ValueError):
                game_bans = 0
            try:
                days_since_last_ban = max(0, int(ban.get("DaysSinceLastBan") or 0))
            except (TypeError, ValueError):
                days_since_last_ban = 0
            economy_ban = str(ban.get("EconomyBan") or "none")
            active = []
            if community_banned:
                active.append("community")
            if vac_banned or vac_bans:
                active.append("vac")
            if game_bans:
                active.append("game")
            if economy_ban.casefold() != "none":
                active.append("economy")
            ban_status = ",".join(active) if active else "clean"
        rows.append({
            "added": fmt_time(ts, utc),
            "friend_since": ts,
            "steamid": sid,
            "name": player.get("personaname") or "",
            "relationship": f.get("relationship") or "",
            "status": state,
            "last_logoff": fmt_time(last_logoff, utc),
            "country": player.get("loccountrycode") or "",
            "game": player.get("gameextrainfo") or "",
            "profile_url": player.get("profileurl") or "",
            "real_name": player.get("realname") or "",
            "account_created": fmt_time(account_created, utc),
            "account_created_timestamp": account_created,
            "visibility": visibility,
            "ban_status": ban_status,
            "community_banned": community_banned,
            "vac_banned": vac_banned,
            "vac_bans": vac_bans,
            "game_bans": game_bans,
            "days_since_last_ban": days_since_last_ban,
            "economy_ban": economy_ban,
        })
    # Entries with friend_since == 0 carry no date; park them at the end in both
    # directions rather than letting them masquerade as 1970.
    dated = [r for r in rows if r["friend_since"]]
    undated = [r for r in rows if not r["friend_since"]]
    dated.sort(key=lambda r: r["friend_since"], reverse=not oldest_first)
    undated.sort(key=lambda r: r["steamid"])
    return dated + undated


def sort_rows(rows: list, field: str, reverse: bool = False) -> list:
    """Sort rows with absent values consistently parked at the end."""
    if field == "added":
        value = lambda row: row["friend_since"]
        descending = not reverse
    elif field == "name":
        value = lambda row: row["name"].casefold()
        descending = reverse
    elif field == "status":
        value = lambda row: STATUS_ORDER.get(row["status"], len(STATUS_ORDER))
        descending = reverse
    elif field == "last-logoff":
        value = lambda row: row["last_logoff"]
        descending = not reverse
    elif field == "account-created":
        value = lambda row: row["account_created_timestamp"]
        descending = not reverse
    elif field == "ban-status":
        value = lambda row: row["ban_status"].casefold()
        descending = reverse
    else:
        raise ValueError(f"unsupported sort field {field!r}")

    if field == "status":
        populated = list(rows)
        missing = []
    elif field == "ban-status":
        populated = [row for row in rows if row["ban_status"] != "unknown"]
        missing = [row for row in rows if row["ban_status"] == "unknown"]
    else:
        populated = [row for row in rows if value(row)]
        missing = [row for row in rows if not value(row)]
    populated.sort(key=lambda row: (value(row), row["steamid"]), reverse=descending)
    missing.sort(key=lambda row: row["steamid"])
    return populated + missing


def parse_date(value: str) -> str:
    """Validate and normalize an ISO calendar date for argparse."""
    try:
        parsed = time.strptime(value, "%Y-%m-%d")
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError(
            f"{value!r} is not a date in YYYY-MM-DD format"
        )
    normalized = time.strftime("%Y-%m-%d", parsed)
    if normalized != value:
        raise argparse.ArgumentTypeError(
            f"{value!r} is not a date in YYYY-MM-DD format"
        )
    return normalized


def parse_columns(value: str) -> list:
    """Parse a comma-separated output column list for argparse."""
    columns = [column.strip().lower().replace("-", "_") for column in value.split(",")]
    if not columns or any(not column for column in columns):
        raise argparse.ArgumentTypeError("columns must be a comma-separated list")
    unknown = [column for column in columns if column not in COLUMN_LABELS]
    if unknown:
        raise argparse.ArgumentTypeError(
            "unknown column{} {}; choose from {}".format(
                "s" if len(unknown) != 1 else "",
                ", ".join(unknown),
                ", ".join(COLUMN_LABELS),
            )
        )
    duplicates = sorted({column for column in columns if columns.count(column) > 1})
    if duplicates:
        raise argparse.ArgumentTypeError(
            "duplicate column{} {}".format(
                "s" if len(duplicates) != 1 else "", ", ".join(duplicates)
            )
        )
    return columns


def filter_rows(
    rows: list, query: str = "", since: str = "", until: str = "",
    state: str = "", country: str = "", playing=None, banned_only: bool = False,
) -> list:
    """Filter rows by identity, friendship date, presence, country, and game."""
    needle = query.casefold().strip()
    game_needle = playing.casefold().strip() if playing is not None else None
    filtered = []
    for row in rows:
        if (needle
                and needle not in row["name"].casefold()
                and needle not in row["steamid"]):
            continue
        added_date = row["added"][:10]
        if since and (not added_date or added_date < since):
            continue
        if until and (not added_date or added_date > until):
            continue
        if state and row["status"] != state:
            continue
        if country and row["country"].upper() != country:
            continue
        if game_needle is not None and (
                not row["game"] or game_needle not in row["game"].casefold()):
            continue
        if banned_only and row["ban_status"] in ("clean", "unknown"):
            continue
        filtered.append(row)
    return filtered


def _table_cell(row: dict, column: str) -> str:
    value = row[column]
    if isinstance(value, bool):
        return "yes" if value else "no"
    if value not in (None, ""):
        return str(value)
    if column in ("added", "friend_since", "last_logoff", "account_created"):
        return "unknown"
    if column in ("game", "real_name"):
        return "—"
    return "?"


def render_table(
    rows: list, show_rel: bool, show_details: bool = False, columns=None,
    show_bans: bool = False,
) -> str:
    if not rows:
        return ""
    if columns is None:
        columns = ["added", "steamid", "name"]
        if show_rel:
            columns.append("relationship")
        if show_details:
            columns += [
                "status", "last_logoff", "country", "game", "real_name",
                "account_created", "visibility", "profile_url",
            ]
        if show_bans:
            columns += BAN_COLUMNS
    headers = ["#"] + [COLUMN_LABELS[column] for column in columns]
    body = []
    for i, r in enumerate(rows, 1):
        cells = [str(i)] + [_table_cell(r, column) for column in columns]
        body.append(cells)
    widths = [
        max(display_width(h), max(display_width(c[i]) for c in body))
        for i, h in enumerate(headers)
    ]
    out = ["  ".join(pad(h, w) for h, w in zip(headers, widths)).rstrip(),
           "  ".join("─" * w for w in widths)]
    out += ["  ".join(pad(c, w) for c, w in zip(cells, widths)).rstrip() for cells in body]
    return "\n".join(out)


def render_summary(rows: list, shown: int = 0) -> str:
    """Per-year breakdown. `rows` is always the FULL list so the counts stay
    honest under --limit; `shown` only annotates how much was displayed."""
    dated = [r for r in rows if r["friend_since"]]
    if not dated:
        return ""
    years = {}
    for r in dated:
        years[r["added"][:4]] = years.get(r["added"][:4], 0) + 1
    peak = max(years.values())
    head = f"{len(rows)} friends"
    if len(dated) != len(rows):
        head += f" ({len(rows) - len(dated)} without a recorded date)"
    if shown and shown < len(rows):
        head += f", {shown} shown"
    lines = ["", head]
    for y in sorted(years):
        bar = "█" * max(1, round(years[y] / peak * 28))
        lines.append(f"  {y}  {bar} {years[y]}")
    return "\n".join(lines)


def output_columns(show_rel: bool, show_details: bool, show_bans: bool = False) -> list:
    columns = ["added", "friend_since", "steamid", "name"]
    if show_rel:
        columns.append("relationship")
    if show_details:
        columns += [
            "status", "last_logoff", "country", "game", "real_name",
            "account_created", "visibility", "profile_url",
        ]
    if show_bans:
        columns += BAN_COLUMNS
    return columns


def write_output(
    rows: list, fmt: str, dest, show_rel: bool, show_details: bool = False,
    columns=None, show_bans: bool = False,
) -> None:
    selected_columns = columns or output_columns(show_rel, show_details, show_bans)
    if fmt == "table":
        table = render_table(rows, show_rel, show_details, columns, show_bans)
        if table:
            dest.write(table + "\n")
    elif fmt == "json":
        json.dump([{key: row[key] for key in selected_columns} for row in rows], dest,
                  indent=2, ensure_ascii=False)
        dest.write("\n")
    elif fmt in ("csv", "tsv"):
        w = csv.DictWriter(dest, fieldnames=selected_columns,
                           delimiter="\t" if fmt == "tsv" else ",",
                           extrasaction="ignore", lineterminator="\n")
        w.writeheader()
        w.writerows(rows)


# ── credential gathering ────────────────────────────────────────────────────

def _ask(prompt: str, hidden: bool = False) -> str:
    """Read one line, treating EOF/Ctrl-C as a clean abort."""
    try:
        return (getpass(prompt) if hidden else input(prompt)).strip()
    except EOFError:
        print(file=sys.stderr)
        die("input ended before a value was given")
    except KeyboardInterrupt:
        print("\ninterrupted", file=sys.stderr)
        sys.exit(130)
    return ""


def prompt_key() -> str:
    print("A Steam Web API key is needed. Get one at:\n"
          "  https://steamcommunity.com/dev/apikey\n"
          "(needs an account that has spent at least $5; 'limited' accounts "
          "cannot create keys)\n", file=sys.stderr)
    for _ in range(3):
        key = _ask("Steam API key (hidden): ", hidden=True)
        if KEY_RE.match(key):
            return key
        print("  that does not look like a key, expected 32 hex characters\n",
              file=sys.stderr)
    die("no valid API key given")


def prompt_identity() -> str:
    print("\nWhose friends list? Accepts a SteamID64, a vanity name, or a profile URL.\n"
          "  e.g. 76561198000000000 | yourvanityname | "
          "https://steamcommunity.com/id/yourvanityname/\n", file=sys.stderr)
    for _ in range(3):
        raw = _ask("Steam ID / vanity / URL: ")
        try:
            parse_identity(raw)
            return raw
        except ValueError as e:
            print(f"  {e}\n", file=sys.stderr)
    die("no valid Steam identity given")


def gather_credentials(args, interactive: bool):
    cfg = load_config()
    key = args.key or os.environ.get("STEAM_API_KEY") or cfg.get("api_key")
    ident = args.id or os.environ.get("STEAM_ID") or cfg.get("steam_id")
    fresh = False

    if not key:
        if not interactive:
            die("no API key.",
                "Supply one with --key, the STEAM_API_KEY environment variable, or run\n"
                "interactively to be prompted. Get a key at "
                "https://steamcommunity.com/dev/apikey")
        key = prompt_key()
        fresh = True
    elif not KEY_RE.match(key.strip()):
        die("the API key is not 32 hex characters.",
            "Copy it again from https://steamcommunity.com/dev/apikey")
    key = key.strip()

    if not ident:
        if not interactive:
            die("no Steam ID.",
                "Supply one with --id, the STEAM_ID environment variable, or run\n"
                "interactively to be prompted.")
        ident = prompt_identity()
        fresh = True

    return key, ident, fresh


# ── main ────────────────────────────────────────────────────────────────────

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="steam-friends",
        description="List a Steam account's friends sorted by when they were added.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  steam-friends                                  interactive\n"
            "  steam-friends --id yourvanityname              newest first\n"
            "  steam-friends --id 7656119999999999 --oldest   oldest first\n"
            "  steam-friends --format csv -o friends.csv      spreadsheet\n"
            "  steam-friends --format json | jq '.[0]'        newest friend\n\n"
            "note: GetFriendList requires the target's \"My friends list\" privacy\n"
            "setting to be Public, which is separate from overall profile privacy.\n"
        ),
    )
    p.add_argument("--key", metavar="HEX32", help="Steam Web API key")
    p.add_argument("--id", metavar="ID", help="SteamID64, vanity name, or profile URL")
    p.add_argument("--relationship", choices=["friend", "all"], default="friend",
                   help="which entries to list (default: friend)")
    p.add_argument("--oldest", action="store_true", help="sort oldest first")
    p.add_argument(
        "--sort", choices=[
            "added", "name", "status", "last-logoff", "account-created", "ban-status",
        ],
        default="added", help="field to sort by (default: added)",
    )
    p.add_argument("--reverse", action="store_true",
                   help="reverse the selected sort order")
    p.add_argument("--match", metavar="TEXT",
                   help="only names or SteamIDs containing TEXT (case-insensitive)")
    p.add_argument("--since", type=parse_date, metavar="YYYY-MM-DD",
                   help="only friendships added on or after this date")
    p.add_argument("--until", type=parse_date, metavar="YYYY-MM-DD",
                   help="only friendships added on or before this date")
    p.add_argument("--state", choices=list(PERSONA_STATES.values()),
                   help="only friends in this Steam presence state")
    p.add_argument("--country", type=lambda value: value.upper(), metavar="CC",
                   help="only friends with this two-letter country code")
    p.add_argument("--playing", nargs="?", const="", metavar="GAME",
                   help="only friends in a game, optionally matching GAME")
    p.add_argument("--format", choices=["table", "csv", "tsv", "json"], default="table",
                   help="output format (default: table)")
    p.add_argument("--columns", type=parse_columns, metavar="LIST",
                   help="comma-separated output columns in the requested order")
    p.add_argument("-o", "--output", metavar="FILE", help="write to FILE instead of stdout")
    p.add_argument("--limit", type=int, metavar="N", help="show only the first N rows")
    p.add_argument("--utc", action="store_true", help="timestamps in UTC (default: local)")
    p.add_argument("--no-names", action="store_true",
                   help="skip persona-name lookup (one less API call per 100 friends)")
    p.add_argument("--details", action="store_true",
                   help="include presence, game, identity, account, and profile details")
    p.add_argument("--bans", action="store_true",
                   help="include public community, VAC, game, and economy ban data")
    p.add_argument("--banned-only", action="store_true",
                   help="only friends with a reported ban")
    p.add_argument("--no-summary", action="store_true", help="omit the per-year breakdown")
    p.add_argument("--save", action="store_true", help="save key and id to the config file")
    p.add_argument("--track", nargs="?", const="", metavar="FILE",
                   help="compare with the last run and update its snapshot")
    p.add_argument("--version", action="version", version=f"steam-friends {VERSION}")
    return p


def main() -> int:
    args = build_parser().parse_args()
    if args.limit is not None and args.limit < 1:
        die("--limit must be 1 or greater")
    if args.since and args.until and args.since > args.until:
        die("--since must not be later than --until")
    if args.oldest and args.sort != "added":
        die("--oldest can only be used with --sort added")
    if args.oldest and args.reverse:
        die("--oldest and --reverse cannot be combined")
    if args.country and not re.match(r"^[A-Z]{2}$", args.country):
        die("--country must be a two-letter country code")
    if args.no_names and (
            args.details or args.state or args.country or args.playing is not None
            or args.sort in PROFILE_SORTS):
        die("--no-names cannot be combined with profile filters, details, or profile sorting")

    needs_bans = (
        args.bans or args.banned_only or args.sort == "ban-status"
        or bool(args.columns and any(column in BAN_COLUMNS for column in args.columns))
    )

    interactive = sys.stdin.isatty() and sys.stderr.isatty()
    key, ident, fresh = gather_credentials(args, interactive)

    try:
        steam_id = resolve(ident, key)
        info(f"fetching friends of {steam_id}…")
        friends = fetch_friends(steam_id, key, args.relationship)

        if not friends:
            info(f"no friends returned for {steam_id} "
                 f"(relationship={args.relationship})")

        players = {} if args.no_names else fetch_players(
            [str(f.get("steamid", "")) for f in friends if f.get("steamid")], key)
        bans = fetch_bans(
            [str(f.get("steamid", "")) for f in friends if f.get("steamid")], key
        ) if needs_bans else {}

    except SteamError as e:
        die(_redact(str(e), key), e.hint)
    except ValueError as e:
        die(str(e))
    except KeyboardInterrupt:
        print("\ninterrupted", file=sys.stderr)
        return 130

    fetched_total = len(friends)
    all_rows = build_rows(friends, players, args.utc, False, bans)
    all_rows = sort_rows(all_rows, args.sort, args.reverse or args.oldest)
    if args.track is not None:
        snapshot_path = args.track or default_snapshot_path(
            steam_id, args.relationship
        )
        try:
            snapshot_report = update_snapshot(
                snapshot_path, steam_id, args.relationship, all_rows
            )
        except SnapshotError as e:
            die(str(e))
        print(snapshot_report, file=sys.stderr)
    all_rows = filter_rows(
        all_rows, args.match or "", args.since or "", args.until or "",
        args.state or "", args.country or "", args.playing, args.banned_only,
    )
    total = len(all_rows)
    rows = all_rows[:args.limit] if args.limit else all_rows

    show_rel = args.relationship == "all"
    if args.output:
        try:
            with open(args.output, "w", encoding="utf-8", newline="") as f:
                write_output(
                    rows, args.format, f, show_rel, args.details, args.columns,
                    args.bans,
                )
        except OSError as e:
            die(f"could not write {args.output}: {e}")
        info(f"wrote {len(rows)} of {total} rows to {args.output}")
    else:
        write_output(
            rows, args.format, sys.stdout, show_rel, args.details, args.columns,
            args.bans,
        )
        # Flush before touching stderr, or the trailer overtakes a
        # block-buffered stdout and prints above the table.
        sys.stdout.flush()

    if args.format == "table" and not args.no_summary:
        summary = render_summary(all_rows, shown=len(rows))
        if summary:
            print(summary, file=sys.stderr)
    if args.limit and args.limit < total:
        info(f"showing {len(rows)} of {total}; omit --limit for the rest")
    if (args.match or args.since or args.until or args.state or args.country
            or args.playing is not None or args.banned_only) and total != fetched_total:
        info(f"filters matched {total} of {fetched_total} friends")

    if fresh and interactive and not args.save:
        try:
            if input("\nSave key and id for next time? [y/N] ").strip().lower() in ("y", "yes"):
                save_config(key, steam_id)
        except (EOFError, KeyboardInterrupt):
            print(file=sys.stderr)
    elif args.save:
        save_config(key, steam_id)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
